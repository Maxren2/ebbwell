# Public URL as seen by browsers (no trailing slash)
APP_URL=https://ebbwell.example.com

# Authentik OAuth2/OpenID provider
OIDC_ISSUER=https://auth.example.com/application/o/ebbwell/
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Optional: comma-separated Authentik groups allowed in (empty = any authenticated user)
OIDC_ALLOWED_GROUPS=ebbwell-users
# Also end the Authentik session on logout (default true)
OIDC_LOGOUT_SSO=true

# 32 random bytes, base64 (openssl rand -base64 32). Required. Back it up offline.
DATA_ENCRYPTION_KEY=
# Set temporarily to the old key when rotating; everything is re-encrypted at startup.
# DATA_ENCRYPTION_KEY_PREVIOUS=

DATA_DIR=/data
PORT=8080
TRUST_PROXY=loopback,uniquelocal
HSTS=true
SESSION_IDLE_DAYS=14
SESSION_MAX_DAYS=90
BACKUP_RETENTION_DAYS=14
LOG_LEVEL=info

# Local development only — never in production:
# AUTH_MODE=dev
# ALLOW_INSECURE_DEV_AUTH=true

# Web Push (reminders). Keys are generated and stored encrypted when unset.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# Contact for push services (mailto: or https:); defaults to APP_URL
# VAPID_SUBJECT=mailto:admin@example.com
